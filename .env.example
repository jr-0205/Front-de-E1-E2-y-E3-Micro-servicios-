# Configuración de desarrollo. Lo normal es generarlo con:
#     node configurar-ips.mjs        (lee las direcciones de `ip-path`)
# Para redes con IP dinámica, preferir DNS local o reservas DHCP.
EQUIPO1_HOST=equipo1.local
EQUIPO2_HOST=equipo2.local
EQUIPO3_HOST=equipo3.local
FRONTEND_HOST=frontend.local

VITE_CLIENTES_URL=http://${EQUIPO1_HOST}:2501
VITE_PRODUCTOS_URL=http://${EQUIPO1_HOST}:2502
VITE_PEDIDOS_URL=http://${EQUIPO2_HOST}:2503
VITE_PAGOS_URL=http://${EQUIPO2_HOST}:2504
VITE_INVENTARIO_URL=http://${EQUIPO3_HOST}:2506
VITE_NOTIFICACIONES_URL=http://${EQUIPO3_HOST}:2507
VITE_FRONTEND_URL=http://${FRONTEND_HOST}:2222
VITE_DEMO_SALES=false

CLIENTES_PORT=2501
PRODUCTOS_PORT=2502
PEDIDOS_PORT=2503
PAGOS_PORT=2504
INVENTARIO_PORT=2506
NOTIFICACIONES_PORT=2507
FRONTEND_PORT=2222
